# Google Sheets Configuration
# Either provide the Sheet ID (from the URL) or the full Google Sheet URL:
GOOGLE_SHEET_KEY=your_google_sheet_id_here
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/your_google_sheet_id_here/edit
GOOGLE_SHEET_NAME=Sheet1
GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# Gemini LLM API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
